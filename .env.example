# Workspace API key from the otari.ai API Keys tab. Never commit a real value.
OTARI_API_KEY=

# Optional. Sent as the Otari-End-User-Budget header when set.
# See docs/HACKATHON.md. Effect on hosted otari.ai was not live-verified.
OTARI_END_USER_BUDGET=

# Optional. Workspace MCP server id (UUID). Sent as mcp_server_ids when set.
# Hosted attachment was not live-verified.
OTARI_MCP_SERVER_ID=

# Optional. HTTPS MCP endpoint. Sent as mcp_servers when set.
# The bundled server is stdio and is not reachable at this URL.
OTARI_MCP_URL=
